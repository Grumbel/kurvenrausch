# clangd / LSP for Kurvenrausch.
# After `cmake -B build`, the compilation database lives in build/.
CompileFlags:
  CompilationDatabase: build
  Add:
    - -std=c++17
    - -Iinclude
    # Quiet missing SDL headers until the package is installed / nix develop.
    - -Wno-unknown-warning-option
Diagnostics:
  UnusedIncludes: None
  MissingIncludes: None
